{
  "name": "guarded-browser",
  "version": "0.2.2",
  "private": true,
  "description": "Desktop web browser with an AI agent that is architecturally defended against prompt injection",
  "main": "dist/main/main.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "guard:report": "vitest run test/unit/guard.test.ts",
    "smoke:local": "node scripts/smoke-local.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "dist": "node scripts/dist.mjs",
    "dist:offline": "node scripts/dist.mjs --offline",
    "test:packaged": "node scripts/run-e2e.mjs test/e2e/packaged.spec.ts",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "tldts": "^7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node": false,
    "protobufjs": false,
    "electron-winstaller": false
  },
  "author": {
    "name": "Optim Enterprises B.V."
  },
  "homepage": "https://www.optimcloud.com/work/guarded-browser",
  "build": {
    "appId": "io.guardedbrowser.app",
    "productName": "Guarded Browser",
    "executableName": "guarded-browser",
    "directories": {
      "output": "dist-pkg",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/smoke-local.js",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_cuda.so",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_tensorrt.so",
      "!**/*.ts",
      "!**/*.map",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/onnxruntime-node/bin/**",
      "**/@img/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icons",
      "executableName": "guarded-browser",
      "synopsis": "Browser with a prompt-injection-hardened AI agent",
      "maintainer": "Optim Enterprises B.V.",
      "vendor": "Optim Enterprises B.V.",
      "desktop": {
        "entry": {
          "Name": "Guarded Browser",
          "GenericName": "Web Browser",
          "Comment": "Web browser with a prompt-injection-hardened AI agent",
          "Categories": "Network;WebBrowser;",
          "MimeType": "text/html;x-scheme-handler/http;x-scheme-handler/https;",
          "StartupWMClass": "guarded-browser"
        }
      }
    },
    "appImage": {
      "artifactName": "guarded-browser-${version}.${arch}.AppImage"
    }
  }
}
